{
  "name": "zero-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.5.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --use-env-proxy --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env --use-env-proxy dist/server/index.js",
    "test": "node --use-env-proxy --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "rss-parser": "3.13.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
